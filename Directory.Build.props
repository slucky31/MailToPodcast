<Project>
  <PropertyGroup>
    <!-- Product version: 10.x.y.z, where 10 is the .NET major version and x.y.z follows SemVer (ADR-0011).
         Versionize only reads and bumps <Version> (the x.y.z part) in the CD release job; never edit it by hand.
         On a .NET upgrade, change DotNetMajor along with TargetFramework. -->
    <DotNetMajor>10</DotNetMajor>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(DotNetMajor).$(Version)</AssemblyVersion>
    <FileVersion>$(DotNetMajor).$(Version)</FileVersion>
    <InformationalVersion>$(DotNetMajor).$(Version)</InformationalVersion>
    <TargetFramework>net$(DotNetMajor).0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Nicolas DUFAUT</Authors>
  </PropertyGroup>
</Project>
